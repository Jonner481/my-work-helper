let currentImageList = [], cssImagesSet = new Set(), htmlImagesSet = new Set(), bothImagesSet = new Set(), externalImagesSet = new Set(), iconImagesSet = new Set(), logoImagesSet = new Set(), homepageImagesSet = new Set(), stockImagesSet = new Set();
let imageSourceMap = new Map(), similarGroups = new Map(), imageToGroup = new Map();
let currentFilter = 'all', sortOrder = 'default', currentContentTab = 'pages', homepageUrl = '', lastCheckedIndex = null, currentDisplayedUrls = [];
let totalOccurrencesCount = 0, trashedCount = 0, duplicatesRemoved = 0, originalTotalOccurrences = 0;
let imageAltMap = new Map(); // Stores {imageUrl: [{pageUrl: pageUrl, alt: altText}]}

// Popup variables
let currentPopupImages = [], currentPopupIndex = 0;

// ============ HELPER FUNCTIONS ==========
function showToast(msg, type = 'success') {
    if(!toastContainer){ 
        toastContainer = document.createElement('div'); 
        toastContainer.className = 'toast-container'; 
        document.body.appendChild(toastContainer); 
    }
    
    // Keep only last 3 toasts
    while(activeToasts.length >= 3){ 
        let old = activeToasts.shift(); 
        if(old && old.parentNode){ 
            old.style.animation = 'fadeOut 0.3s forwards'; 
            setTimeout(() => old.parentNode?.removeChild(old), 300); 
        } 
    }
    
    let toast = document.createElement('div'); 
    toast.className = `toast ${type}`; 
    
    // Shorten common messages
    let shortMsg = msg;
    if (msg.includes('Parsed')) shortMsg = msg.replace('occurrences', 'occ').replace('unique images', 'imgs');
    if (msg.includes('Deleted')) shortMsg = msg.substring(0, 50);
    if (msg.includes('Selected')) shortMsg = msg.replace('images', 'img');
    
    toast.textContent = shortMsg; 
    toastContainer.appendChild(toast); 
    activeToasts.push(toast);
    
    // Auto-hide after 2 seconds (faster)
    setTimeout(() => { 
        let idx = activeToasts.indexOf(toast); 
        if(idx > -1) activeToasts.splice(idx,1); 
        toast.style.animation = 'fadeOut 0.3s forwards'; 
        setTimeout(() => toast.parentNode?.removeChild(toast), 500); 
    }, 2000);
}

function isValidImageUrl(url) {
    if (url.startsWith('data:image/svg+xml')) return false;
    if (!url || url.length < 10) return false;
    if (url.includes('viewBox=') && url.includes('svg')) return false;
    return true;
}

function getDomain(url) {
    try { return new URL(url).hostname.replace(/^www\./, ''); } catch(e) { return ''; }
}

function isSameDomain(url1, url2) {
    try {
        let domain1 = new URL(url1).hostname.replace(/^www\./, '');
        let domain2 = new URL(url2).hostname.replace(/^www\./, '');
        
        // Check if one is subdomain of the other
        return domain1 === domain2 || 
               domain1.endsWith('.' + domain2) || 
               domain2.endsWith('.' + domain1);
    } catch(e) { return false; }
}

function isIconImage(url) {
    let low = url.toLowerCase(), fn = url.split('/').pop().toLowerCase();
    if(fn.endsWith('.svg')) return true;
    if(fn.match(/\d+x\d+/) && parseInt(fn.match(/\d+/)[0]) <= 64) return true;
    let kw = ['icon', 'ico', 'favicon', 'sprite', 'symbol', 'glyph', 'facebook', 'twitter', 'instagram', 'linkedin', 'youtube', 'pinterest', 'social', 'share', 'like', 'comment', 'heart', 'star', 'menu', 'hamburger', 'close', 'search', 'cart', 'user', 'arrow', 'chevron', 'play', 'pause', 'volume', 'fullscreen', 'calendar', 'clock', 'location', 'email', 'phone', 'message', 'warning', 'info', 'check', 'circle', 'square', 'triangle'];
    return kw.some(k => low.includes(k));
}

function isLogoImage(url) {
    let low = url.toLowerCase();
    let kw = ['logo', 'brand', 'header-logo', 'footer-logo', 'site-logo', 'company-logo'];
    return kw.some(k => low.includes(k));
}

function isStockImage(url) {
    let low = url.toLowerCase();
    let patterns = ['envato', 'shutterstock', 'adobe', 'istock', 'gettyimages', 'depositphotos', 'freepik', 'pexels', 'unsplash', 'pixabay', '123rf', 'dreamstime', 'alamy', 'canstock', 'bigstock'];
    return patterns.some(p => low.includes(p));
}

function getBaseName(fn) {
    return fn.toLowerCase().replace(/-\d+x\d+/,'').replace(/-\d+/,'').replace(/[0-9a-f]{8,}/,'').replace(/-v\d+/,'').replace(/\.(jpg|jpeg|png|gif|webp|svg)$/i,'').replace(/[-_]/g,' ').trim();
}

function groupSimilarImages(imgs) {
    similarGroups.clear(); 
    imageToGroup.clear(); 
    let groups = new Map();
    for(let url of imgs) {
        let fn = url.split('/').pop().split('?')[0];
        let bn = getBaseName(fn);
        if(!groups.has(bn)) groups.set(bn, []);
        groups.get(bn).push(url);
    }
    let gid = 0;
    for(let [bn, urls] of groups) {
        if(urls.length > 1) {
            for(let u of urls) imageToGroup.set(u, gid);
            similarGroups.set(gid, new Set(urls));
            gid++;
        }
    }
}

function updateStats() {
    document.getElementById('pagesCount').textContent = detectedPages.length;
    document.getElementById('articlesCount').textContent = detectedArticles.length;
    document.getElementById('totalPagesScanned').textContent = detectedPages.length + detectedArticles.length;
    document.getElementById('totalOccurrences').textContent = originalTotalOccurrences;
    document.getElementById('uniqueCount').textContent = uniqueImages.size;
    document.getElementById('duplicatesRemoved').textContent = duplicatesRemoved;
    document.getElementById('externalCount').textContent = externalImagesSet.size;
    document.getElementById('homepageCount').textContent = homepageImagesSet.size;
    document.getElementById('similarGroupCount').textContent = similarGroups.size;
    document.getElementById('selectedCount').textContent = selectedImages.size;
    document.getElementById('trashedCount').textContent = trashedCount;
    document.getElementById('externalCountBadge').textContent = externalImagesSet.size;
    document.getElementById('pagesTabCount').textContent = `(${detectedPages.length})`;
    document.getElementById('articlesTabCount').textContent = `(${detectedArticles.length})`;
}

function saveStateToUndo() {
    if(isUndoRedoOperation) return;
    let state = {
        detectedPages: [...detectedPages], detectedArticles: [...detectedArticles],
        externalImagesList: [...externalImagesList], allImages: [...allImages],
        uniqueImages: Array.from(uniqueImages), selectedImages: Array.from(selectedImages),
        cssImagesSet: Array.from(cssImagesSet), htmlImagesSet: Array.from(htmlImagesSet),
        bothImagesSet: Array.from(bothImagesSet), externalImagesSet: Array.from(externalImagesSet),
        iconImagesSet: Array.from(iconImagesSet), logoImagesSet: Array.from(logoImagesSet),
        homepageImagesSet: Array.from(homepageImagesSet), stockImagesSet: Array.from(stockImagesSet),
        imageSourceMap: Array.from(imageSourceMap.entries()),
        similarGroups: Array.from(similarGroups.entries()).map(([id, urls]) => [id, Array.from(urls)]),
        imageToGroup: Array.from(imageToGroup.entries()),
        homepageUrl, totalOccurrencesCount, trashedCount, duplicatesRemoved, originalTotalOccurrences: originalTotalOccurrences // ADD duplicatesRemoved
    };
    
    if(currentMode === 'crawler') {
        crawlerUndoStack.push(state);
        crawlerRedoStack = [];
    } else {
        directUndoStack.push(state);
        directRedoStack = [];
    }
}

function restoreState(state, isRedo = false) {
    isUndoRedoOperation = true;
    detectedPages = state.detectedPages || [];
    detectedArticles = state.detectedArticles || [];
    externalImagesList = state.externalImagesList || [];
    allImages = state.allImages || [];
    uniqueImages = new Set(state.uniqueImages || []);
    selectedImages = new Set(state.selectedImages || []);
    cssImagesSet = new Set(state.cssImagesSet || []);
    htmlImagesSet = new Set(state.htmlImagesSet || []);
    bothImagesSet = new Set(state.bothImagesSet || []);
    externalImagesSet = new Set(state.externalImagesSet || []);
    iconImagesSet = new Set(state.iconImagesSet || []);
    logoImagesSet = new Set(state.logoImagesSet || []);
    homepageImagesSet = new Set(state.homepageImagesSet || []);
    stockImagesSet = new Set(state.stockImagesSet || []);
    imageSourceMap = new Map(state.imageSourceMap || []);
    homepageUrl = state.homepageUrl || '';
    totalOccurrencesCount = state.totalOccurrencesCount || 0;
    trashedCount = state.trashedCount || 0;
    duplicatesRemoved = state.duplicatesRemoved || 0;  
    originalTotalOccurrences = state.originalTotalOccurrences || 0; 
    
    similarGroups.clear();
    imageToGroup.clear();
    if(state.similarGroups) {
        for(let [id, urls] of state.similarGroups) {
            similarGroups.set(parseInt(id), new Set(urls));
        }
    }
    if(state.imageToGroup) {
        for(let [url, id] of state.imageToGroup) {
            imageToGroup.set(url, parseInt(id));
        }
    }
    
    updateStats();
    displayDetectedPages();
    displayDetectedArticles();
    displayExternalImages();
    displayImagesOptimized();
    updateFilterVisibility();
    isUndoRedoOperation = false;
    showToast(isRedo ? '↪️ Redo' : '↩️ Undo');
}

function undo() {
    let undoStack = currentMode === 'crawler' ? crawlerUndoStack : directUndoStack;
    let redoStack = currentMode === 'crawler' ? crawlerRedoStack : directRedoStack;
    
    if(undoStack.length === 0) { showToast('Nothing to undo', 'error'); return; }
    
    let cur = {
        detectedPages: [...detectedPages], detectedArticles: [...detectedArticles],
        externalImagesList: [...externalImagesList], allImages: [...allImages],
        uniqueImages: Array.from(uniqueImages), selectedImages: Array.from(selectedImages),
        cssImagesSet: Array.from(cssImagesSet), htmlImagesSet: Array.from(htmlImagesSet),
        bothImagesSet: Array.from(bothImagesSet), externalImagesSet: Array.from(externalImagesSet),
        iconImagesSet: Array.from(iconImagesSet), logoImagesSet: Array.from(logoImagesSet),
        homepageImagesSet: Array.from(homepageImagesSet), stockImagesSet: Array.from(stockImagesSet),
        imageSourceMap: Array.from(imageSourceMap.entries()),
        similarGroups: Array.from(similarGroups.entries()).map(([id, urls]) => [id, Array.from(urls)]),
        imageToGroup: Array.from(imageToGroup.entries()),
        homepageUrl, totalOccurrencesCount, trashedCount
    };
    redoStack.push(cur);
    let prev = undoStack.pop();
    restoreState(prev, false);
    closePopup();
}

function redo() {
    let undoStack = currentMode === 'crawler' ? crawlerUndoStack : directUndoStack;
    let redoStack = currentMode === 'crawler' ? crawlerRedoStack : directRedoStack;
    
    if(redoStack.length === 0) { showToast('Nothing to redo', 'error'); return; }
    
    let cur = {
        detectedPages: [...detectedPages], detectedArticles: [...detectedArticles],
        externalImagesList: [...externalImagesList], allImages: [...allImages],
        uniqueImages: Array.from(uniqueImages), selectedImages: Array.from(selectedImages),
        cssImagesSet: Array.from(cssImagesSet), htmlImagesSet: Array.from(htmlImagesSet),
        bothImagesSet: Array.from(bothImagesSet), externalImagesSet: Array.from(externalImagesSet),
        iconImagesSet: Array.from(iconImagesSet), logoImagesSet: Array.from(logoImagesSet),
        homepageImagesSet: Array.from(homepageImagesSet), stockImagesSet: Array.from(stockImagesSet),
        imageSourceMap: Array.from(imageSourceMap.entries()),
        similarGroups: Array.from(similarGroups.entries()).map(([id, urls]) => [id, Array.from(urls)]),
        imageToGroup: Array.from(imageToGroup.entries()),
        homepageUrl, totalOccurrencesCount, trashedCount
    };
    undoStack.push(cur);
    let nxt = redoStack.pop();
    restoreState(nxt, true);
    closePopup();
}

// KEYBOARD NAVIGATION - FIXED
document.addEventListener('keydown', (e) => {
    if(e.ctrlKey && e.key === 'z') { e.preventDefault(); undo(); }
    else if(e.ctrlKey && e.key === 'y') { e.preventDefault(); redo(); }
    
    // Popup keyboard navigation
    let pop = document.getElementById('popup');
    if(pop && pop.style.display === 'flex') {
        if(e.key === 'ArrowLeft') { e.preventDefault(); prevImage(); }
        else if(e.key === 'ArrowRight') { e.preventDefault(); nextImage(); }
        else if(e.key === 'Escape') { e.preventDefault(); closePopup(); }
    }
});

function selectAllVisibleImages() {
    const checkboxes = document.querySelectorAll('.image-card .checkbox');
    if(checkboxes.length === 0) { showToast('No images', 'warning'); return; }
    saveStateToUndo();
    checkboxes.forEach(cb => {
        const url = cb.getAttribute('data-url');
        if(url && !selectedImages.has(url)) selectedImages.add(url);
        cb.checked = true;
    });
    document.querySelectorAll('.image-card').forEach(card => {
        if(card.querySelector('.checkbox')?.checked) card.classList.add('selected');
    });
    updateStats();
    updateFilterVisibility();
    showToast(`✅ ${selectedImages.size} selected`);
}

function deselectAllImages() {
    saveStateToUndo();
    selectedImages.clear();
    displayImagesOptimized();
    updateStats();
