    const urls = textarea.value.split(/\r?\n/).map(u => u.trim()).filter(u => u && (u.startsWith('http://') || u.startsWith('https://')));
    if(urls.length === 0) { showToast('No URLs', 'warning'); return; }
    
    saveStateToUndo();
    let addedCount = 0;
    for(let url of urls) {
        if(!uniqueImages.has(url)) {
            uniqueImages.add(url);
            allImages.push(url);
            imageSourceMap.set(url, ['Manual Input']);
            totalOccurrencesCount++;
            addedCount++;
            if(isIconImage(url)) iconImagesSet.add(url);
            if(isLogoImage(url)) logoImagesSet.add(url);
            if(isStockImage(url)) stockImagesSet.add(url);
        }
    }
    groupSimilarImages(Array.from(uniqueImages));
    updateStats();
    displayImagesOptimized();
    updateFilterVisibility();
    showToast(`✅ Added ${addedCount}`);
}

