            if(!cssUnique.has(css)){ 
                cssUnique.add(css); 
                logLine = \`🎨 [CSS]\${externalTag}\${articleTag} \${css} [SOURCE] \${pageUrl}\`;
                console.log(logLine);
            } else { 
                duplicateCount++;
                logLine = \`🎨 [CSS]\${externalTag} (duplicate)\${articleTag} \${css} [SOURCE] \${pageUrl}\`;
                console.log(logLine);
            }
            accumulatedOutput.push(logLine);
        }
        ` : ''}
        
        const completeMsg = \`   ✅ Page \${currentIdx} complete! Found \${imgImages.length + ${includeCss ? 'cssImages.length' : '0'}} images\`;
        console.log(completeMsg);
        accumulatedOutput.push(completeMsg);
        console.log('');
        accumulatedOutput.push('');

      } catch (e) {
        const errorMsg = \`   ⚠️ Failed: \${shortName} - \${e.message}\`;
        console.warn(errorMsg);
        accumulatedOutput.push(errorMsg);
        console.log('');
        accumulatedOutput.push('');
      }
    }));
    
    if (batchEnd < allPagesToCrawl.length) {
      await new Promise(r => setTimeout(r, BREATH_DELAY));
    }
  }

  const both = new Set([...htmlUnique].filter(x => cssUnique.has(x)));
  const htmlOnly = htmlUnique.size - both.size;
  const cssOnly = cssUnique.size - both.size;
  
  let externalCount = 0;
  let allUnique = new Set([...htmlUnique, ...cssUnique]);
  for(let u of allUnique) {
    try { 
      let urlDomain = new URL(u).hostname.replace(/^www\\./,''); 
      if(!urlDomain.includes(baseDomain)) externalCount++; 
    } catch(e){}
  }
  
  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
  console.log('🎉 CRAWL COMPLETE! 🎉');
  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
  console.log('📊 FINAL SUMMARY:');
  console.log(\`   📄 Pages scanned: \${pagesScanned}\`);
  console.log(\`   📝 Articles scanned: \${articlesScanned}\`);
  console.log(\`   📚 TOTAL pages scanned: \${pagesScanned + articlesScanned}\`);
  console.log(\`   🖼️ HTML only: \${htmlOnly}\`);
  console.log(\`   🎨 CSS only: \${cssOnly}\`);
  console.log(\`   🌀 Both: \${both.size}\`);
  console.log(\`   🌍 External: \${externalCount}\`);
  console.log(\`   📝 Duplicate lines: \${duplicateCount}\`);
  console.log(\`   🖼️ Total unique images: \${htmlOnly + cssOnly + both.size}\`);
  console.log(\`   📊 Total occurrences: \${totalOccurrences}\`);
  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
  
  const domain = new URL(window.location.origin).hostname;
  const now = new Date();
  const month = String(now.getMonth() + 1).padStart(2, '0');
  const day = String(now.getDate()).padStart(2, '0');
  const year = now.getFullYear();
  const hours = String(now.getHours()).padStart(2, '0');
  const minutes = String(now.getMinutes()).padStart(2, '0');
  const seconds = String(now.getSeconds()).padStart(2, '0');
  const filename = \`CRS-\${domain}-\${month}-\${day}-\${year}~\${hours}\${minutes}\${seconds}.txt\`;
  
  const summaryOutput = \`━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
🎉 CRAWL COMPLETE! 🎉
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
📊 FINAL SUMMARY:
   📄 Pages scanned: \${pagesScanned}
   📝 Articles scanned: \${articlesScanned}
   📄 Total pages scanned: \${pagesScanned + articlesScanned}
   🖼️ HTML only: \${htmlOnly}
   🎨 CSS only: \${cssOnly}
   🌀 Both: \${both.size}
   🌍 External: \${externalCount}
   📝 Duplicate lines: \${duplicateCount}
   🖼️ Total unique images: \${htmlOnly + cssOnly + both.size}
   📊 Total occurrences: \${totalOccurrences}
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
📋 FULL OUTPUT (copy this entire file into the tool):
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
\${accumulatedOutput.join('\\n')}
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\`;

  const blob = new Blob([summaryOutput], {type: 'text/plain'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  
  console.log(\`📁 Results saved to file: \${filename}\`);
  window.s = function() {
      const blob2 = new Blob([summaryOutput], {type: 'text/plain'});
      const url2 = URL.createObjectURL(blob2);
      const a2 = document.createElement('a');
      a2.href = url2;
      a2.download = filename;
      document.body.appendChild(a2);
      a2.click();
      document.body.removeChild(a2);
      URL.revokeObjectURL(url2);
      console.log('✅ Results re-saved!');
  };
  console.log('💡 TIP: Type "s()" in console to download again');
})();`;
}

function updateCrawlerCode() {
    document.getElementById('crawlerCode').textContent = getCrawlerCode();
}

function copyCrawlerCode() {
    navigator.clipboard.writeText(document.getElementById('crawlerCode').textContent).then(() => showToast('✅ Crawler code copied!'));
}

