function extractNumber(fn) {
    let m = fn.match(/(\d+)/);
    return m ? parseInt(m[0]) : null;
}

function sortImages(imgs) {
    if(sortOrder === 'numbersLast') {
        return [...imgs].sort((a, b) => {
            let na = a.split('/').pop().split('?')[0].toLowerCase();
            let nb = b.split('/').pop().split('?')[0].toLowerCase();
            let numa = extractNumber(na), numb = extractNumber(nb);
            if(numa !== null && numb !== null) return numa - numb;
            if(numa !== null) return 1;
            if(numb !== null) return -1;
            return na.localeCompare(nb);
        });
    }
    return [...imgs];
}

function groupImagesForDisplay(images) {
    if(currentFilter !== 'similar') return images.map(img => ({ type: 'image', url: img }));
    let grouped = [], processed = new Set();
    let sorted = Array.from(similarGroups.entries()).sort((a, b) => b[1].size - a[1].size);
    for(let [gid, urls] of sorted) {
        let arr = Array.from(urls);
        let grpImgs = images.filter(img => arr.includes(img));
        if(grpImgs.length > 1) {
            grouped.push({ type: 'group-header', groupId: gid, count: grpImgs.length });
            for(let img of grpImgs.sort()) {
                grouped.push({ type: 'image', url: img });
                processed.add(img);
            }
        }
    }
    for(let img of images) if(!processed.has(img)) grouped.push({ type: 'image', url: img });
    return grouped;
}

