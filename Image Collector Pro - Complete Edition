function updateFilterVisibility() {
    let htmlCnt = Array.from(uniqueImages).filter(u => htmlImagesSet.has(u) && !bothImagesSet.has(u)).length;
    let cssCnt = Array.from(uniqueImages).filter(u => cssImagesSet.has(u) && !bothImagesSet.has(u)).length;
    let extCnt = externalImagesSet.size;
    let iconCnt = Array.from(uniqueImages).filter(u => iconImagesSet.has(u)).length;
    let logoCnt = Array.from(uniqueImages).filter(u => logoImagesSet.has(u)).length;
    let homeCnt = homepageImagesSet.size;
    let similarCnt = Array.from(uniqueImages).filter(u => imageToGroup.has(u)).length;
    let stockCnt = stockImagesSet.size;
    
    let filters = [
        { name: 'html', count: htmlCnt, label: '🖼️ HTML' },
        { name: 'css', count: cssCnt, label: '🎨 CSS' },
        { name: 'external', count: extCnt, label: '🌐 External' },
        { name: 'icons', count: iconCnt, label: '🔘 Icons' },
        { name: 'logos', count: logoCnt, label: '🏷️ Logos' },
        { name: 'homepage', count: homeCnt, label: '🏠 Homepage' },
        { name: 'similar', count: similarCnt, label: '🔄 Similar' },
        { name: 'stock', count: stockCnt, label: '🛒 Stock' }
    ];
    
    for(let f of filters) {
        let btn = document.querySelector(`.filter-badge.${f.name}`);
        if(btn) {
            if(f.count === 0) {
                btn.classList.add('hidden');
            } else {
                btn.classList.remove('hidden');
                btn.innerHTML = `${f.label} (${f.count})`;
            }
            
            let delBtn = btn.querySelector('.filter-delete');
            if(!delBtn && f.count > 0) {
                delBtn = document.createElement('button');
                delBtn.className = 'filter-delete';
                delBtn.innerHTML = '✕';
                delBtn.title = `Delete all ${f.name} images`;
                delBtn.onclick = (e) => { 
                    e.stopPropagation(); 
                    deleteByFilter(f.name); 
                };
                btn.appendChild(delBtn);
            }
        }
    }
    
    let allBtn = document.querySelector('.filter-badge.all');
    if(allBtn) {
        if(uniqueImages.size === 0) {
            allBtn.classList.add('hidden');
        } else {
            allBtn.classList.remove('hidden');
            allBtn.innerHTML = `📊 All (${uniqueImages.size})`;
        }
    }
}

function deleteByFilter(ftype) {
    let toDel = [];
    if(ftype === 'html') toDel = Array.from(uniqueImages).filter(u => htmlImagesSet.has(u) && !bothImagesSet.has(u));
    else if(ftype === 'css') toDel = Array.from(uniqueImages).filter(u => cssImagesSet.has(u) && !bothImagesSet.has(u));
    else if(ftype === 'external') toDel = Array.from(uniqueImages).filter(u => externalImagesSet.has(u));
    else if(ftype === 'icons') toDel = Array.from(uniqueImages).filter(u => iconImagesSet.has(u));
    else if(ftype === 'logos') toDel = Array.from(uniqueImages).filter(u => logoImagesSet.has(u));
    else if(ftype === 'homepage') toDel = Array.from(uniqueImages).filter(u => homepageImagesSet.has(u));
    else if(ftype === 'similar') toDel = Array.from(uniqueImages).filter(u => imageToGroup.has(u));
    else if(ftype === 'stock') toDel = Array.from(uniqueImages).filter(u => stockImagesSet.has(u));
    
    if(!toDel.length) { showToast(`No ${ftype} images to delete`, 'warning'); return; }
    
    saveStateToUndo();
    
    let deletedUniqueCount = toDel.length;
    let deletedOccurrences = 0;
    
    for(let url of toDel) {
        let occurrencesForThisImage = imageSourceMap.get(url)?.length || 0;
        deletedOccurrences += occurrencesForThisImage;
        
        uniqueImages.delete(url);
        selectedImages.delete(url);
        let gid = imageToGroup.get(url);
        if(gid !== undefined) {
            let grp = similarGroups.get(gid);
            if(grp) {
                grp.delete(url);
                if(grp.size <= 1) {
                    similarGroups.delete(gid);
                    for(let rem of grp) imageToGroup.delete(rem);
                }
            }
            imageToGroup.delete(url);
        }
        
        cssImagesSet.delete(url);
        htmlImagesSet.delete(url);
        bothImagesSet.delete(url);
        externalImagesSet.delete(url);
        iconImagesSet.delete(url);
        logoImagesSet.delete(url);
        homepageImagesSet.delete(url);
        stockImagesSet.delete(url);
        imageSourceMap.delete(url);
    }
    
    // DO NOT change totalOccurrencesCount - keep original value
    trashedCount += deletedUniqueCount;
    
    displayImagesOptimized();
    updateStats();
    updateFilterVisibility();
    
    let order = ['all', 'html', 'css', 'external', 'icons', 'logos', 'homepage', 'similar', 'stock'];
    let idx = order.indexOf(currentFilter);
    for(let i = idx + 1; i < order.length; i++) {
        let btn = document.querySelector(`.filter-badge.${order[i]}`);
        if(btn && !btn.classList.contains('hidden')) {
            filterByType(order[i]);
            break;
        }
    }
    showToast(`🗑️ Deleted ${deletedUniqueCount} ${ftype} unique images (${deletedOccurrences} occurrences removed, Total trashed: ${trashedCount})`);
}

