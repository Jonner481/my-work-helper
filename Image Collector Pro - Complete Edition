                const start = Math.min(lastCheckedIndex, clickedIdx);
                const end = Math.max(lastCheckedIndex, clickedIdx);
                for(let i = start; i <= end; i++) {
                    const imgUrl = currentDisplayedUrls[i];
                    if(isChecked) {
                        if(!selectedImages.has(imgUrl)) selectedImages.add(imgUrl);
                    } else {
                        if(selectedImages.has(imgUrl)) selectedImages.delete(imgUrl);
                    }
                }
                updateStats();
                displayImagesOptimized();
                updateFilterVisibility();
                showToast(`${isChecked ? 'Selected' : 'Deselected'} ${end - start + 1} images`);
            } else {
                if(isChecked) selectedImages.add(url);
                else selectedImages.delete(url);
                updateStats();
                card.classList.toggle('selected', isChecked);
                updateFilterVisibility();
            }
            lastCheckedIndex = clickedIdx;
        };
        
        chk.addEventListener('change', (e) => {
            let ci = parseInt(chk.getAttribute('data-index'));
            handleChange(e, ci);
        });
        labelSpan.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            chk.checked = !chk.checked;
            let ci = parseInt(chk.getAttribute('data-index'));
            let fake = { shiftKey: e.shiftKey, stopPropagation: () => {} };
            handleChange(fake, ci);
        });
        
        return card;
    }
    
    const BATCH_SIZE = 20;
    let index = 0;
    
    function renderBatch() {
        const fragment = document.createDocumentFragment();
        let batchEnd = Math.min(index + BATCH_SIZE, grouped.length);
        
        for(let i = index; i < batchEnd; i++) {
            const item = grouped[i];
            if(item.type === 'group-header') {
                const header = document.createElement('div');
                header.className = 'group-separator';
                header.innerHTML = `📁 Similar Images Group (${item.count} images)`;
                fragment.appendChild(header);
            } else {
                fragment.appendChild(createImageCard(item.url, i));
            }
        }
        
        container.appendChild(fragment);
        index = batchEnd;
        if(index < grouped.length) requestAnimationFrame(renderBatch);
    }
    
    requestAnimationFrame(renderBatch);
}

// ============ PARSE FUNCTION - IMPROVED VERSION ==========
async function parseConsoleOutputOptimized() {
    const parseBtn = document.getElementById('parseBtn');
    parseBtn.classList.add('btn-loading');
    parseBtn.disabled = true;
    parseBtn.textContent = '⏳ Parsing...';
    
    const text = document.getElementById('consoleOutput').value;
    const lines = text.split(/\r?\n/);
    
    // Reset ALL data
    detectedPages = [];
    detectedArticles = [];
    externalImagesList = [];
    allImages = [];
    uniqueImages.clear();
    selectedImages.clear();
    cssImagesSet.clear();
    htmlImagesSet.clear();
    bothImagesSet.clear();
    externalImagesSet.clear();
    iconImagesSet.clear();
    logoImagesSet.clear();
    homepageImagesSet.clear();
    stockImagesSet.clear();
    imageSourceMap.clear();
    similarGroups.clear();
    imageToGroup.clear();
    homepageUrl = '';
    totalOccurrencesCount = 0;
    trashedCount = 0;
    
    // Extract console summary numbers
    let consoleTotalOccurrences = null;
    let consoleUniqueImages = null;
    let consolePagesScanned = 0;
    let consoleArticlesScanned = 0;
    
    for(let line of lines) {
        let totalMatch = line.match(/📊 Total occurrences:\s*(\d+)/i);
        if(totalMatch) consoleTotalOccurrences = parseInt(totalMatch[1]);
        let uniqueMatch = line.match(/🖼️ Total unique images:\s*(\d+)/i);
        if(uniqueMatch) consoleUniqueImages = parseInt(uniqueMatch[1]);
        
        // FIXED: Extract pages and articles from crawler summary
        let pagesMatch = line.match(/📄 Pages scanned:\s*(\d+)/i);
        if(pagesMatch) consolePagesScanned = parseInt(pagesMatch[1]);
        
        let articlesMatch = line.match(/📝 Articles scanned:\s*(\d+)/i);
        if(articlesMatch) consoleArticlesScanned = parseInt(articlesMatch[1]);
    }
    
    // ============ PAGE DETECTION - FIXED ============
    let pageSet = new Set();
    let articleSet = new Set();

    // FIRST: Find all article URLs from image lines that have (article) marker
    for(let line of lines) {
        if(line.includes('(article)') && line.includes('[SOURCE]')) {
            let sourceMatch = line.match(/\[SOURCE\]\s*(https?:\/\/[^\s]+)/i);
            if(sourceMatch) {
                let articleUrl = sourceMatch[1];
                if(!articleUrl.startsWith('http')) articleUrl = 'https://' + articleUrl;
                articleSet.add(articleUrl);
                console.log(`📝 Article found from marker: ${articleUrl}`);
            }
        }
    }

    // SECOND: Get all crawled URLs from Crawling lines
    for(let line of lines) {
        if(line.includes('Crawling:') && (line.includes('📄') || line.includes('📝'))) {
            let urlMatch = line.match(/Crawling:\s*([^\s]+)/i);
            if(urlMatch) {
                let pUrl = urlMatch[1];
                if(!pUrl.startsWith('http')) pUrl = 'https://' + pUrl;
                
                // If this URL is already in articleSet, skip adding to pages
                if(!articleSet.has(pUrl)) {
                    pageSet.add(pUrl);
                }
            }
        }
    }

    detectedPages = Array.from(pageSet);
    detectedArticles = Array.from(articleSet);

    console.log(`✅ Pages: ${detectedPages.length}, Articles: ${detectedArticles.length}, Total: ${detectedPages.length + detectedArticles.length}`);

    if(!homepageUrl && detectedPages.length) {
        try { 
            let firstUrl = detectedPages[0];
            let uo = new URL(firstUrl);
            homepageUrl = uo.origin + '/';
        } catch(e) {}
    }
    
    console.log(`📄 Detected ${detectedPages.length} pages, ${detectedArticles.length} articles`);
    
    const homeUrlHttps = homepageUrl.replace('http://', 'https://');
    const homeUrlHttp = homepageUrl.replace('https://', 'http://');
    const homeOriginHttps = homeUrlHttps.replace(/\/$/, '');
    const homeOriginHttp = homeUrlHttp.replace(/\/$/, '');
    
    let baseDomain = homepageUrl ? getDomain(homepageUrl) : '';
    
    // ============ IMAGE PARSING ============
    let imgPattern = /(https?:\/\/[^\s<>"'\)\]\[]+\.(?:jpg|jpeg|png|gif|webp|bmp|svg|ico|avif|heic)(?:\?[^\s<>"'\)\]\[]*)?)/gi;
    let srcPattern = /\[SOURCE\]\s*(https?:\/\/[^\s<>"'\)\]]+)/i;
    let urlPattern = /(https?:\/\/[^\s<>"'\)\]]+)/gi;
    
    let imageData = new Map();
    let totalImageLines = 0;
    
    for(let line of lines) {
        if(!line.includes('🖼️') && !line.includes('🎨') && !line.includes('http')) continue;
        
        let srcMatch = line.match(srcPattern);
        let srcUrl = null;
        
        if(srcMatch) {
            srcUrl = srcMatch[1];
            if(!srcUrl.startsWith('http')) {
                srcUrl = 'https://' + srcUrl;
            }
        } else {
            let allUrls = line.match(urlPattern);
            if(allUrls && allUrls.length > 0) {
                srcUrl = allUrls[0];
                if(!srcUrl.startsWith('http')) {
                    srcUrl = 'https://' + srcUrl;
                }
            }
        }
        
        if(!srcUrl) continue;
        
        let imgMatches = line.matchAll(imgPattern);
        let foundInLine = false;
        
        for(let imgMatch of imgMatches) {
            let imgUrl = imgMatch[0];
            imgUrl = imgUrl.replace(/[.,;:!?)$]+$/, '');
            imgUrl = decodeURIComponent(imgUrl);
            
            let altMatch = line.match(/alt\s*=\s*["']([^"']*)["']/i);
            let altText = altMatch ? altMatch[1] : '(no alt text)';
            
            foundInLine = true;
            totalImageLines++;
            
            if(!imageData.has(imgUrl)) {
                imageData.set(imgUrl, { 
                    sources: new Set(), 
                    isHtml: false, 
                    isCss: false, 
                    occurrences: 0,
                    altTexts: new Map()
                });
            }
            let data = imageData.get(imgUrl);
            data.sources.add(srcUrl);
            data.occurrences++;
            
            if (!data.altTexts.has(srcUrl)) {
                data.altTexts.set(srcUrl, altText);
            }
            
            if(line.includes('🎨') || line.includes('[CSS]')) {
                data.isCss = true;
            }
            if(line.includes('🖼️') || line.includes('[HTML]') || (!line.includes('[CSS]') && !line.includes('🎨'))) {
                data.isHtml = true;
            }
        }
    }
    
    console.log(`📊 Found ${imageData.size} unique images from ${totalImageLines} image lines`);
    
    // Process image data
    for(let [url, data] of imageData) {
        let cleanUrl = url.split('?')[0];
        
        uniqueImages.add(cleanUrl);
        allImages.push(cleanUrl);
        let sourcesArray = Array.from(data.sources);
        imageSourceMap.set(cleanUrl, sourcesArray);
        imageAltMap.set(cleanUrl, data.altTexts);
        totalOccurrencesCount += data.occurrences;
        
        if (baseDomain && !isSameDomain(cleanUrl, homepageUrl) && isValidImageUrl(cleanUrl)) {
            externalImagesSet.add(cleanUrl);
            externalImagesList.push(cleanUrl);
        }
        
        if(data.isHtml && data.isCss) {
            bothImagesSet.add(cleanUrl);
            htmlImagesSet.add(cleanUrl);
            cssImagesSet.add(cleanUrl);
        } else if(data.isHtml) {
            htmlImagesSet.add(cleanUrl);
        } else if(data.isCss) {
            cssImagesSet.add(cleanUrl);
        }
        
        let isHomepageImage = false;
        for(let src of data.sources) {
            try {
                const srcParsed = new URL(src);
                const srcNormalized = src.replace(/\/$/, '');
                
                const matchesHomepage = (
                    src === homeUrlHttps ||
                    src === homeUrlHttps.replace(/\/$/, '') ||
                    src === homeUrlHttp ||
                    src === homeUrlHttp.replace(/\/$/, '') ||
                    srcNormalized === homeOriginHttps ||
                    srcNormalized === homeOriginHttp ||
                    (srcParsed.origin === homeOriginHttps && (srcParsed.pathname === '/' || srcParsed.pathname === '')) ||
                    (srcParsed.origin === homeOriginHttp && (srcParsed.pathname === '/' || srcParsed.pathname === ''))
                );
                
                if(matchesHomepage) {
                    isHomepageImage = true;
                    break;
                }
            } catch(e) {}
        }
        
        if(isHomepageImage) {
            homepageImagesSet.add(cleanUrl);
        }
        
        if(isIconImage(cleanUrl)) iconImagesSet.add(cleanUrl);
        if(isLogoImage(cleanUrl)) logoImagesSet.add(cleanUrl);
        if(isStockImage(cleanUrl)) stockImagesSet.add(cleanUrl);
    }
    
    duplicatesRemoved = totalOccurrencesCount - uniqueImages.size;
    originalTotalOccurrences = totalOccurrencesCount;
    
    groupSimilarImages(Array.from(uniqueImages));
    
    // Save to crawler data store
    crawlerData = {
        detectedPages: [...detectedPages], detectedArticles: [...detectedArticles],
        externalImagesList: [...externalImagesList], allImages: [...allImages],
        uniqueImages: new Set(uniqueImages), selectedImages: new Set(selectedImages),
        cssImagesSet: new Set(cssImagesSet), htmlImagesSet: new Set(htmlImagesSet),
        bothImagesSet: new Set(bothImagesSet), externalImagesSet: new Set(externalImagesSet),
        iconImagesSet: new Set(iconImagesSet), logoImagesSet: new Set(logoImagesSet),
        homepageImagesSet: new Set(homepageImagesSet), stockImagesSet: new Set(stockImagesSet),
        imageSourceMap: new Map(imageSourceMap),
        similarGroups: new Map(Array.from(similarGroups.entries()).map(([k, v]) => [k, new Set(v)])),
        imageToGroup: new Map(imageToGroup),
        homepageUrl, totalOccurrencesCount, trashedCount: 0, duplicatesRemoved, originalTotalOccurrences
    };
    
    if(currentMode !== 'crawler') switchMode('crawler');
    
    updateStats();
    displayDetectedPages();
    displayDetectedArticles();
    displayExternalImages();
    await displayImagesOptimized();
    updateFilterVisibility();
    
    showToast(`✅ Parsed: ${totalOccurrencesCount} occurrences, ${uniqueImages.size} unique images`, 'success');
    
    parseBtn.classList.remove('btn-loading');
    parseBtn.disabled = false;
    parseBtn.textContent = '🔍 Parse Output';
}

