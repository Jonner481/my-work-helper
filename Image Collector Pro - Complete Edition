function importData(event) {
    const file = event.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        try {
            const content = e.target.result;
            let data;
            try {
                data = JSON.parse(content);
            } catch(jsonError) {
                if(currentMode !== 'crawler') switchMode('crawler');
                document.getElementById('consoleOutput').value = content;
                parseConsoleOutputOptimized();
                return;
            }
            
            if(data.mode === 'direct' && currentMode !== 'direct') switchMode('direct');
            else if(data.mode === 'crawler' && currentMode !== 'crawler') switchMode('crawler');
            
            detectedPages = data.detectedPages || [];
            detectedArticles = data.detectedArticles || [];
            externalImagesList = data.externalImagesList || [];
            homepageUrl = data.homepageUrl || '';
            allImages = data.allImages || [];
            uniqueImages = new Set(data.uniqueImages || []);
            cssImagesSet = new Set(data.cssImagesSet || []);
            htmlImagesSet = new Set(data.htmlImagesSet || []);
            bothImagesSet = new Set(data.bothImagesSet || []);
            externalImagesSet = new Set(data.externalImagesSet || []);
            iconImagesSet = new Set(data.iconImagesSet || []);
            logoImagesSet = new Set(data.logoImagesSet || []);
            homepageImagesSet = new Set(data.homepageImagesSet || []);
            stockImagesSet = new Set(data.stockImagesSet || []);
            imageSourceMap = new Map(data.imageSourceMap || []);
            selectedImages = new Set(data.selectedImages || []);
            totalOccurrencesCount = data.totalOccurrencesCount || 0;
            trashedCount = data.trashedCount || 0;
            originalTotalOccurrences = data.originalTotalOccurrences || totalOccurrencesCount;
            
            similarGroups.clear();
            imageToGroup.clear();
            if(data.similarGroups) {
                for(let [id, urls] of data.similarGroups) {
                    similarGroups.set(parseInt(id), new Set(urls));
                }
            }
            if(data.imageToGroup) {
                for(let [url, id] of data.imageToGroup) {
                    imageToGroup.set(url, parseInt(id));
                }
            }

            imageAltMap = new Map();
            if(data.imageAltMap) {
                for(let [url, altEntries] of data.imageAltMap) {
                    imageAltMap.set(url, new Map(altEntries));
                }
            }
            
            updateStats();
            displayDetectedPages();
            displayDetectedArticles();
            displayExternalImages();
            displayImagesOptimized();
            updateFilterVisibility();
            showToast(`✅ Imported ${uniqueImages.size}`);
        } catch(err) {
            showToast('❌ Invalid file format', 'error');
        }
    };
    reader.readAsText(file);
    event.target.value = '';
}

